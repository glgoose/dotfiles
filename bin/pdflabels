#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["pikepdf"]
# ///

import sys
import pikepdf

def error(msg):
    print(f"Error: {msg}", file=sys.stderr)
    print(f"Error: {msg}")  # mirror to stdout so Zotero subprocess() callers see it too
    sys.exit(1)

if len(sys.argv) == 3 and sys.argv[1] in ('-c', '--check'):
    pdf_file = sys.argv[2]
    try:
        with pikepdf.open(pdf_file) as pdf:
            if '/PageLabels' in pdf.Root:
                samples = [(i + 1, pdf.pages[i].label) for i in (0, len(pdf.pages) // 2, len(pdf.pages) - 1)]
                print(f"yes ({len(pdf.pages)} pages; samples " + ", ".join(f"p{p}='{l}'" for p, l in samples) + ")")
                sys.exit(0)
            print("no")
            sys.exit(1)
    except Exception as e:
        error(str(e))

if len(sys.argv) != 4:
    error("Usage: pdflabels START_LABEL END_LABEL file.pdf\n       pdflabels --check file.pdf")

start_label = sys.argv[1]
end_label   = sys.argv[2]
pdf_file    = sys.argv[3]

try:
    with pikepdf.open(pdf_file) as pdf:
        if '/PageLabels' not in pdf.Root:
            error("PDF has no /PageLabels — add them with qpdf first")
        labels = {}
        for i, page in enumerate(pdf.pages):
            labels.setdefault(page.label, i + 1)
except SystemExit:
    raise
except Exception as e:
    error(str(e))

if start_label not in labels:
    error(f"Label '{start_label}' not found in PDF")
if end_label not in labels:
    error(f"Label '{end_label}' not found in PDF")

if labels[start_label] > labels[end_label]:
    error(f"Start label '{start_label}' (page {labels[start_label]}) is after end label '{end_label}' (page {labels[end_label]})")

print(f"{labels[start_label]} {labels[end_label]}")
