<script>
const CUES = __CUES_JSON__;
const BASE = __BASE_JSON__;
const VERSION = __VERSION_JSON__;
const STORAGE_KEY = `lec-review:${BASE}:v${VERSION}`;

let state = loadState();
let currentIdx = 0;

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch (e) {}
  return {};
}
function saveState() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  refreshProgress();
}
function refreshProgress() {
  const decided = CUES.filter(c => state[c.id]?.action).length;
  document.getElementById("progress").textContent = `${decided} / ${CUES.length} decided`;
}

function diffWords(before, after) {
  const bw = before.split(/(\s+)/);
  const aw = after.split(/(\s+)/);
  let i = 0, j = 0;
  let prefix = 0, suffix = 0;
  while (prefix < bw.length && prefix < aw.length && bw[prefix] === aw[prefix]) prefix++;
  while (suffix < bw.length - prefix && suffix < aw.length - prefix
         && bw[bw.length - 1 - suffix] === aw[aw.length - 1 - suffix]) suffix++;
  const beforeMid = bw.slice(prefix, bw.length - suffix).join("");
  const afterMid = aw.slice(prefix, aw.length - suffix).join("");
  const head = bw.slice(0, prefix).join("");
  const tail = bw.slice(bw.length - suffix).join("");
  return {
    beforeHtml: escapeHtml(head) + (beforeMid ? `<del>${escapeHtml(beforeMid)}</del>` : "") + escapeHtml(tail),
    afterHtml: escapeHtml(head) + (afterMid ? `<ins>${escapeHtml(afterMid)}</ins>` : "") + escapeHtml(tail),
  };
}
function escapeHtml(s) {
  return s.replace(/[&<>"']/g, ch => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[ch]));
}

function renderCard(cue, idx) {
  const cur = state[cue.id] || {};
  const d = diffWords(cue.before, cue.after);
  const conf = cue.llm_conf == null ? "?" : cue.llm_conf.toFixed(2);
  const lowConf = cue.llm_conf != null && cue.llm_conf < 0.85;
  const pad = cur.pad ?? 1;
  const action = cur.action ?? "";
  const customText = cur.text ?? cue.after;
  const note = cur.note ?? "";
  const decidedCls = action ? " decided" : "";

  const cands = cue.candidates.map((c, n) => {
    const picked = action === `pick${n+1}` ? " picked" : "";
    return `<button class="cand${picked}" data-pick="${n+1}">${n+1}. ${escapeHtml(c)}</button>`;
  }).join("");

  const ctxHtml = (cue.prev_text || cue.next_text)
    ? `<div class="context">
         ${cue.prev_text ? `<span class="ctx-label">prev cue</span> ${escapeHtml(cue.prev_text)}<br>` : ""}
         ${cue.next_text ? `<span class="ctx-label">next cue</span> ${escapeHtml(cue.next_text)}` : ""}
       </div>` : "";

  return `
    <div class="card${decidedCls}" data-idx="${idx}" data-cue="${cue.id}" id="cue-${cue.id}">
      <div class="cue-head">
        <span class="cue-id">Cue ${cue.id}</span>
        <span class="cue-ts">${cue.start} → ${cue.end}</span>
        <span class="badge${cue.asr_conf === 'low' ? ' warn' : ''}">ASR ${cue.asr_conf || '?'}</span>
        <span class="badge${lowConf ? ' warn' : ''}">LLM ${conf}</span>
      </div>
      ${cue.reason ? `<div class="reason">${escapeHtml(cue.reason)}</div>` : ""}
      ${ctxHtml}
      <div class="diff">
        <span class="label">before</span>
        <div class="row">${d.beforeHtml}</div>
      </div>
      <div class="diff">
        <span class="label">after</span>
        <div class="row">${d.afterHtml}</div>
      </div>
      <div class="audio-row">
        <audio controls preload="none" src="clips/${cue.id}.pad${pad}.wav"></audio>
        <div class="pad-toggle" data-pad-toggle>
          <button data-pad="0"${pad===0?' class="active"':''}>±0s</button>
          <button data-pad="1"${pad===1?' class="active"':''}>±1s</button>
          <button data-pad="3"${pad===3?' class="active"':''}>±3s</button>
        </div>
      </div>
      ${cands ? `<div class="candidates">${cands}</div>` : ""}
      <div class="decision">
        <label class="${action==='accept'?'checked':''}"><input type="radio" name="d-${cue.id}" value="accept"${action==='accept'?' checked':''}> accept</label>
        <label class="k ${action==='keep'?'checked':''}"><input type="radio" name="d-${cue.id}" value="keep"${action==='keep'?' checked':''}> keep original</label>
        <label class="i ${action==='inaudible'?'checked':''}"><input type="radio" name="d-${cue.id}" value="inaudible"${action==='inaudible'?' checked':''}> inaudible</label>
        <label class="${action==='custom'?'checked':''}"><input type="radio" name="d-${cue.id}" value="custom"${action==='custom'?' checked':''}> custom</label>
      </div>
      <div class="custom-area${action==='custom'?' show':''}">
        <textarea data-custom>${escapeHtml(customText)}</textarea>
      </div>
      <div class="note-row">
        <label>note (optional)</label>
        <input type="text" data-note value="${escapeHtml(note)}" placeholder="why this decision">
      </div>
    </div>
  `;
}

function renderAll() {
  const filter = document.getElementById("filter").value;
  const visible = CUES.filter(c => {
    if (filter === "undecided") return !state[c.id]?.action;
    if (filter === "lowconf") return c.llm_conf != null && c.llm_conf < 0.85;
    return true;
  });
  if (visible.length === 0) {
    document.getElementById("cards").innerHTML = '<div class="empty">No cues match filter.</div>';
    return;
  }
  document.getElementById("cards").innerHTML = visible.map((c, i) => renderCard(c, i)).join("");
  attachHandlers();
  markCurrent();
  refreshProgress();
}

function attachHandlers() {
  document.querySelectorAll(".card").forEach(card => {
    const cueId = parseInt(card.dataset.cue);
    card.querySelectorAll('input[type=radio]').forEach(r => {
      r.addEventListener("change", () => {
        const cur = state[cueId] || {};
        cur.action = r.value;
        state[cueId] = cur;
        saveState();
        // Update label classes
        card.querySelectorAll('.decision label').forEach(l => l.classList.remove("checked"));
        r.closest("label").classList.add("checked");
        // Show/hide custom
        card.querySelector(".custom-area").classList.toggle("show", r.value === "custom");
        card.classList.toggle("decided", true);
      });
    });
    card.querySelectorAll('[data-pad]').forEach(btn => {
      btn.addEventListener("click", () => {
        const pad = parseInt(btn.dataset.pad);
        const cur = state[cueId] || {};
        cur.pad = pad;
        state[cueId] = cur;
        saveState();
        card.querySelectorAll('[data-pad]').forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        const audio = card.querySelector("audio");
        const wasPlaying = !audio.paused;
        audio.src = `clips/${cueId}.pad${pad}.wav`;
        if (wasPlaying) audio.play();
      });
    });
    card.querySelectorAll('[data-pick]').forEach(btn => {
      btn.addEventListener("click", () => {
        const n = parseInt(btn.dataset.pick);
        const cur = state[cueId] || {};
        cur.action = `pick${n}`;
        cur.text = btn.textContent.replace(/^\d+\.\s*/, "");
        state[cueId] = cur;
        saveState();
        card.querySelectorAll('.cand').forEach(b => b.classList.remove("picked"));
        btn.classList.add("picked");
        // Uncheck radios
        card.querySelectorAll('input[type=radio]').forEach(r => r.checked = false);
        card.querySelectorAll('.decision label').forEach(l => l.classList.remove("checked"));
        card.classList.add("decided");
      });
    });
    const ta = card.querySelector("[data-custom]");
    if (ta) {
      ta.addEventListener("input", () => {
        const cur = state[cueId] || {};
        cur.text = ta.value;
        state[cueId] = cur;
        saveState();
      });
    }
    const noteInput = card.querySelector("[data-note]");
    noteInput.addEventListener("input", () => {
      const cur = state[cueId] || {};
      cur.note = noteInput.value;
      state[cueId] = cur;
      saveState();
    });
  });
}

function markCurrent() {
  document.querySelectorAll(".card").forEach(c => c.classList.remove("current"));
  const cards = document.querySelectorAll(".card");
  if (cards[currentIdx]) cards[currentIdx].classList.add("current");
}

function jumpTo(idx) {
  const cards = document.querySelectorAll(".card");
  if (idx < 0) idx = 0;
  if (idx >= cards.length) idx = cards.length - 1;
  currentIdx = idx;
  markCurrent();
  cards[idx].scrollIntoView({ behavior: "smooth", block: "start" });
}

document.addEventListener("keydown", e => {
  if (["TEXTAREA", "INPUT"].includes(e.target.tagName)) return;
  const cards = document.querySelectorAll(".card");
  const curCard = cards[currentIdx];
  if (!curCard) return;
  const cueId = parseInt(curCard.dataset.cue);
  const cue = CUES.find(c => c.id === cueId);

  if (e.key === "j" || e.key === "ArrowDown") { e.preventDefault(); jumpTo(currentIdx + 1); }
  else if (e.key === "p" || e.key === "ArrowUp") { e.preventDefault(); jumpTo(currentIdx - 1); }
  else if (e.key === " ") {
    e.preventDefault();
    const audio = curCard.querySelector("audio");
    if (audio.paused) audio.play(); else audio.pause();
  }
  else if (["a", "k", "i", "c"].includes(e.key)) {
    const map = { a: "accept", k: "keep", i: "inaudible", c: "custom" };
    const action = map[e.key];
    const radio = curCard.querySelector(`input[value="${action}"]`);
    if (radio) { radio.checked = true; radio.dispatchEvent(new Event("change")); }
  }
  else if (e.key >= "1" && e.key <= "9") {
    const btn = curCard.querySelector(`[data-pick="${e.key}"]`);
    if (btn) btn.click();
    else {
      const padBtn = curCard.querySelector(`[data-pad="${e.key}"]`);
      if (padBtn) padBtn.click();
    }
  }
  else if (e.key === "0") {
    const padBtn = curCard.querySelector(`[data-pad="0"]`);
    if (padBtn) padBtn.click();
  }
});

document.getElementById("filter").addEventListener("change", renderAll);
document.getElementById("reset").addEventListener("click", () => {
  if (!confirm("Clear all decisions for this review queue?")) return;
  state = {};
  saveState();
  renderAll();
});
document.getElementById("download").addEventListener("click", () => {
  const decisions = CUES
    .filter(c => state[c.id]?.action)
    .map(c => {
      const s = state[c.id];
      const out = { cue_id: c.id, action: s.action };
      if (s.action === "custom") out.text = s.text ?? c.after;
      if (s.action.startsWith("pick")) out.text = s.text;
      if (s.note) out.note = s.note;
      return out;
    });
  const payload = {
    base: BASE,
    version: VERSION,
    generated_at: new Date().toISOString(),
    decisions,
  };
  const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "REVIEW.decisions.json";
  a.click();
  URL.revokeObjectURL(url);
});

renderAll();
</script>
</body>
</html>
"""


def build_html(base, version, cues, srt_lookup):
    """Inject prev/next cue context, then template-substitute into HTML."""
    enriched = []
    for cue in cues:
        c = dict(cue)
        c["prev_text"] = srt_lookup.get(cue["id"] - 1, "")[:200]
        c["next_text"] = srt_lookup.get(cue["id"] + 1, "")[:200]
        enriched.append(c)

    cues_json = json.dumps(enriched, ensure_ascii=False)
    return (HTML_TEMPLATE
            .replace("__BASE__", html.escape(base))
            .replace("__VERSION__", str(version))
            .replace("__TOTAL__", str(len(cues)))
            .replace("__CUES_JSON__", cues_json)
            .replace("__BASE_JSON__", json.dumps(base))
            .replace("__VERSION_JSON__", json.dumps(str(version))))


def main():
    ap = argparse.ArgumentParser(
        description="Generate a self-contained HTML review UI from REVIEW.md.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("base", nargs="?", help="lecture base name (auto-detected if omitted)")
    ap.add_argument("-r", "--review", help="explicit REVIEW.md path (default: latest matching)")
    ap.add_argument("-v", "--version", type=int, help="pre-improve/v<N>/ version to read")
    ap.add_argument("-n", "--no-open", action="store_true", help="don't auto-open browser")
    ap.add_argument("-f", "--force", action="store_true", help="re-extract clips even if cached")
    args = ap.parse_args()

    if not shutil.which("ffmpeg"):
        die("ffmpeg not found")

    base = args.base or find_base()
    srt = find_srt(base)
    audio = find_audio(base)

    review_md = args.review
    if not review_md and args.version is not None:
        review_md = f"pre-improve/v{args.version}/REVIEW.md"
        if not Path(review_md).is_file():
            die(f"--version {args.version}: {review_md} not found")
    if not review_md:
        review_md = find_review_md(base)

    review_dir = Path(review_md).parent
    version_match = re.search(r"v(\d+)", review_dir.name)
    version = version_match.group(1) if version_match else "?"

    cues = parse_review_md(review_md)
    if not cues:
        die(f"no reviewable cues in {review_md}")
    print(f"Base:     {base}", file=sys.stderr)
    print(f"Review:   {review_md}  ({len(cues)} cue{'s' if len(cues)!=1 else ''})", file=sys.stderr)
    print(f"Audio:    {audio}", file=sys.stderr)

    clips_dir = review_dir / "clips"
    if args.force and clips_dir.exists():
        shutil.rmtree(clips_dir)
    print(f"Clips:    extracting → {clips_dir}/", file=sys.stderr)
    extract_all_clips(audio, cues, clips_dir)

    srt_lookup = parse_srt_for_context(srt)
    html_out = review_dir / "REVIEW.html"
    html_out.write_text(build_html(base, version, cues, srt_lookup))
    print(f"HTML:     {html_out}", file=sys.stderr)

    if not args.no_open and sys.platform == "darwin":
        subprocess.run(["open", str(html_out)], check=False)


if __name__ == "__main__":
    main()
