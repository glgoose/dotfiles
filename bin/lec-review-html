#!/usr/bin/env python3
# lec-review-html — generate a self-contained HTML review UI from a
# pre-improve/v<N>/REVIEW.md queue.
#
# Output:
#   pre-improve/v<N>/REVIEW.html              single-file UI
#   pre-improve/v<N>/clips/<cue>.pad{0,1,3}.wav  per-cue audio at 3 padding levels
#
# Decisions made in the browser are exported as
# pre-improve/v<N>/REVIEW.decisions.json (download button); apply them
# with `lec-apply-log <base>`.

import argparse
import base64
import html
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

AUDIO_EXTS = ("flac", "wav", "opus", "m4a", "mp3", "mp4", "aac", "ogg", "oga", "webm", "weba", "aiff", "aif", "mka", "amr")
PAD_LEVELS = (0.0, 1.0, 3.0)
TS_RE = r"\d{1,2}(?::\d{2}){1,2}[\.,]\d{3}"


def die(msg, code=1):
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(code)


def find_base():
    """Auto-detect lecture base from cwd if not given."""
    cands = set()
    for ext in ("srt", "diarized.srt"):
        for p in Path(".").glob(f"*.{ext}"):
            name = p.name
            if name.endswith(".diarized.srt"):
                cands.add(name[:-len(".diarized.srt")])
            else:
                cands.add(name[:-len(".srt")])
    if len(cands) == 1:
        return cands.pop()
    if len(cands) == 0:
        die("no .srt found in cwd; pass <base> explicitly")
    die(f"multiple bases found ({sorted(cands)}); pass one explicitly")


def find_srt(base):
    for cand in (f"{base}.diarized.srt", f"{base}.srt"):
        if Path(cand).is_file():
            return cand
    die(f"no SRT for base '{base}'")


def find_audio(base):
    for ext in AUDIO_EXTS:
        p = Path(f"{base}.{ext}")
        if p.is_file():
            return str(p)
    die(f"no audio file for base '{base}'")


def find_review_md(base, explicit=None):
    if explicit:
        if not Path(explicit).is_file():
            die(f"--review path not found: {explicit}")
        return explicit
    candidates = sorted(Path(".").glob("pre-improve/v*/REVIEW.md"), reverse=True)
    for c in candidates:
        try:
            first = c.read_text().splitlines()[0]
        except Exception:
            continue
        if base in first:
            return str(c)
    die(f"no open REVIEW.md for base '{base}' under pre-improve/v*/")


def ts_to_sec(ts):
    ts = ts.replace(",", ".")
    parts = ts.split(":")
    if len(parts) == 2:
        h, m, rest = "0", parts[0], parts[1]
    elif len(parts) == 3:
        h, m, rest = parts
    else:
        die(f"bad timestamp: {ts}")
    return int(h) * 3600 + int(m) * 60 + float(rest)


def parse_review_md(path):
    """Parse REVIEW.md into a list of cue dicts. Mirrors lec-review parser."""
    content = Path(path).read_text()
    chunks = re.split(r"^##\s+Cue\s+", content, flags=re.MULTILINE)[1:]
    out = []
    for chunk in chunks:
        head = re.match(
            rf"(\d+)\s*(?:--|—|->|→)\s*({TS_RE})\s*(?:--|—|->|→)\s*({TS_RE})",
            chunk,
        )
        if not head:
            continue
        bef = re.search(r"\*\*Before\*\*:\s*`([^`]*)`", chunk)
        aft = re.search(r"\*\*After\*\*:\s*`([^`]*)`", chunk)
        if not bef or not aft:
            continue
        llm = re.search(r"\*\*LLM conf\*\*:\s*([0-9.]+)", chunk)
        asr = re.search(r"\*\*ASR conf\*\*:\s*(\w+)", chunk)
        reason = re.search(r"\*\*Reason\*\*:\s*(.+?)(?=\n\*\*|\n```|\n~~~|\Z)", chunk, re.DOTALL)
        after_text = aft.group(1)
        cands = []
        if "(unclear:" in after_text:
            inner = re.search(r"\(unclear:\s*(.+?)\)\s*$", after_text)
            if inner:
                for raw in inner.group(1).split("/"):
                    c = raw.strip()
                    c = re.sub(r"^(possibly|maybe)\s+", "", c, flags=re.I)
                    c = c.strip("'\"")
                    if c:
                        cands.append(c)
        out.append({
            "id": int(head.group(1)),
            "start": head.group(2),
            "end": head.group(3),
            "start_sec": ts_to_sec(head.group(2)),
            "end_sec": ts_to_sec(head.group(3)),
            "before": bef.group(1),
            "after": after_text,
            "llm_conf": float(llm.group(1)) if llm else None,
            "asr_conf": asr.group(1) if asr else None,
            "reason": (reason.group(1).strip() if reason else "").replace("\n", " "),
            "candidates": cands,
        })
    return out


def parse_srt_for_context(srt_path):
    """Return {cue_id: cue_text} so we can show prev/next context."""
    text = Path(srt_path).read_text()
    blocks = re.split(r"\n\s*\n", text)
    out = {}
    for blk in blocks:
        lines = blk.splitlines()
        if not lines or not lines[0].strip().isdigit():
            continue
        cue_id = int(lines[0].strip())
        body = " ".join(lines[2:]).strip() if len(lines) > 2 else ""
        body = re.sub(r"^\[SPEAKER_\d+\]\s*", "", body)
        out[cue_id] = body
    return out


def extract_clip(audio, start, end, pad, out_path):
    """ffmpeg-extract a single padded clip."""
    s = max(0.0, start - pad)
    e = end + pad
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
        "-ss", f"{s:.3f}",
        "-to", f"{e:.3f}",
        "-i", audio,
        "-ac", "1", "-ar", "22050",
        "-c:a", "pcm_s16le",
        str(out_path),
    ]
    subprocess.run(cmd, check=True)


def extract_all_clips(audio, cues, clips_dir):
    """Extract pad0/pad1/pad3 clips for each cue. Skip existing files."""
    clips_dir.mkdir(parents=True, exist_ok=True)
    total = len(cues) * len(PAD_LEVELS)
    done = 0
    for cue in cues:
        for pad in PAD_LEVELS:
            tag = f"pad{int(pad)}"
            out = clips_dir / f"{cue['id']}.{tag}.wav"
            if not out.exists():
                extract_clip(audio, cue["start_sec"], cue["end_sec"], pad, out)
            done += 1
            print(f"  clip {done}/{total} ({cue['id']} {tag})", end="\r", file=sys.stderr)
    print(" " * 60, end="\r", file=sys.stderr)


