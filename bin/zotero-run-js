#!/usr/bin/env bash
# zotero-run-js — run a .js file in Zotero's Tools > Developer > Run JavaScript console
# Usage: zotero-run-js [--keep-open|-k] <script.js>
# Drives Zotero via AppleScript/System Events, prints the console's Result pane to
# stdout. Zotero must be running. See ~/dotfiles/zotero/ for script conventions —
# unlike Actions & Tags scripts, there is no implicit `item`/`items` binding here;
# fetch items explicitly (e.g. Zotero.Items.getByLibraryAndKeyAsync(...)).
# The Run JavaScript window is closed again once the result has been read, so the
# console does not stay parked on top of Zotero; --keep-open leaves it up for
# inspecting a failing script.
set -euo pipefail

USAGE="Usage: zotero-run-js [--keep-open|-k] <script.js>"

KEEP_OPEN=0
SCRIPT_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --keep-open|-k) KEEP_OPEN=1; shift ;;
    -*) echo "Error: unknown option: $1"; echo "$USAGE"; exit 1 ;;
    *)
      [[ -n "$SCRIPT_FILE" ]] && { echo "Error: expected exactly one script argument"; echo "$USAGE"; exit 1; }
      SCRIPT_FILE="$1"; shift ;;
  esac
done

if [[ -z "$SCRIPT_FILE" ]]; then
  echo "Error: expected exactly one script argument"
  echo "$USAGE"
  exit 1
fi

[[ -f "$SCRIPT_FILE" ]] || { echo "Error: not a file: $SCRIPT_FILE"; exit 1; }
case "$SCRIPT_FILE" in
  *.js) ;;
  *) echo "Error: expected a .js file: $SCRIPT_FILE"; exit 1 ;;
esac

command -v osascript >/dev/null 2>&1 || { echo "Error: osascript not found (macOS only)"; exit 1; }
command -v pbcopy >/dev/null 2>&1 || { echo "Error: pbcopy not found (macOS only)"; exit 1; }

pbcopy < "$SCRIPT_FILE"

run_once() {
  ZOTERO_RUN_JS_KEEP_OPEN="$KEEP_OPEN" osascript <<'APPLESCRIPT'
tell application "Zotero" to activate
delay 0.5

set keepOpen to ((system attribute "ZOTERO_RUN_JS_KEEP_OPEN") is "1")

tell application "System Events"
    tell process "Zotero"
        set frontmost to true

        -- a leftover window should be rare now (we close ours on the way out),
        -- but one left by --keep-open or a crashed run is unreliable to
        -- paste/focus into (accessibility clicks land on it but keystrokes
        -- silently go elsewhere), so close and reopen unconditionally.
        if (exists window "Run JavaScript") then
            click button 1 of window "Run JavaScript"
            delay 0.6
        end if
        click menu item "Run JavaScript" of menu "Developer" of menu item "Developer" of menu "Tools" of menu bar item "Tools" of menu bar 1
        delay 1.0

        set w to window "Run JavaScript"
        set allElems to entire contents of w

        set taList to {}
        set runBtn to missing value
        set asyncCb to missing value
        repeat with e in allElems
            if role of e is "AXTextArea" then
                set end of taList to e
            end if
            if role of e is "AXButton" and (name of e as string) is "Run" then
                set runBtn to e
            end if
            if role of e is "AXCheckBox" then
                set asyncCb to e
            end if
        end repeat

        set codeArea to item 1 of taList
        set resultArea to item 2 of taList

        -- force "Run as async function" on, so top-level await/return work
        if asyncCb is not missing value then
            if (value of attribute "AXValue" of asyncCb) is not 1 then
                click asyncCb
            end if
        end if

        click codeArea
        delay 0.5
        keystroke "a" using {command down}
        delay 0.3
        key code 51
        delay 0.3
        keystroke "v" using {command down}
        delay 0.7

        click runBtn
        delay 1.2

        -- read the result first: closing the window discards the Result pane
        set res to value of resultArea
        if not keepOpen then
            click button 1 of w
            delay 0.3
        end if
        return res
    end tell
end tell
APPLESCRIPT
}

# If the window paste/focus was flaky (see comment above), nothing ran and
# Zotero's console shows its empty-run fallback — "===>undefined<===" — instead
# of a real result. Retry once on that, and on empty output. Anything else is
# the script's own return value (often raw JSON), so don't second-guess it:
# an earlier version demanded an OK:/EXCEPTION:/ERROR: prefix here and so
# re-ran every plain-JSON script needlessly, doubling the exposure to the very
# flakiness this retry exists to paper over.
RESULT="$(run_once)"
if [[ -z "$RESULT" || "$RESULT" == *"===>undefined<==="* ]]; then
  RESULT="$(run_once)"
fi

echo "$RESULT"

# A thrown error is rendered by the console as its own text, e.g. "Error: boom"
# or "TypeError: …" — no EXCEPTION:/ERROR: prefix — so match those too, or a
# failing script exits 0 and callers treat the error text as a result.
case "$RESULT" in
  EXCEPTION:*|ERROR:*|Error:*|TypeError:*|ReferenceError:*|SyntaxError:*|RangeError:*|InternalError:* ) exit 1 ;;
esac
